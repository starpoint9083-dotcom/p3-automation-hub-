{
  "projectId": "K-YOUTUBE",
  "name": "K-YouTube Free",
  "role": "P3 YouTube Korean viewing module",
  "deploymentOwner": "AppDeploy",
  "appId": "k-youtube-free-r0zsy7",
  "deployUrl": "https://k-youtube-free-r0zsy7.v2.appdeploy.ai/",
  "mode": "external-supervisor",
  "health": {
    "type": "frontend-root",
    "path": "/",
    "expectedStatus": 200,
    "expectedHtmlMarkers": ["id=\"root\"", "K-YouTube Free"]
  },
  "retryPolicy": {
    "attempts": 5,
    "delaySeconds": 12,
    "timeoutSeconds": 15
  },
  "costPolicy": {
    "paidTranslationApi": false,
    "paidDubApi": false,
    "paidTtsApi": false,
    "freeOnly": true
  },
  "capabilities": {
    "youtubeOfficialEmbed": true,
    "preferKoreanCaptions": true,
    "useExistingKoreanAudioTrackWhenAvailable": true,
    "browserKoreanTtsAssist": true,
    "androidYoutubeLinkReceiver": true,
    "androidShareTarget": true,
    "androidDefaultBrowserGateway": true,
    "androidNonYoutubeForwardToBrowser": true,
    "androidAutomaticVerifiedDomainOwnership": false,
    "universalFreeLiveDubbing": false
  },
  "androidApp": {
    "packageId": "com.kyoutube.free",
    "versionCode": 2,
    "versionName": "0.2.0",
    "sourcePath": "android/k-youtube-app",
    "webEngineUrl": "https://k-youtube-free-r0zsy7.v2.appdeploy.ai/",
    "handoffQueryParameter": "youtube",
    "buildWorkflow": "P3 K-YouTube Android APK",
    "artifactName": "k-youtube-free-debug-apk",
    "acceptedHosts": [
      "youtube.com",
      "www.youtube.com",
      "m.youtube.com",
      "music.youtube.com",
      "youtu.be"
    ],
    "supportsShareText": true,
    "supportsDefaultBrowserGateway": true,
    "nonYoutubePreferredBrowsers": [
      "com.android.chrome",
      "com.sec.android.app.sbrowser"
    ],
    "verifiedYouTubeDomainOwner": false
  },
  "protected": {
    "neverDeleteOrRename": ["appdeploy:k-youtube-free-r0zsy7"],
    "neverReplaceDeploymentOwnerWithoutExplicitMigration": true
  },
  "automationPolicy": {
    "p3MayObserve": true,
    "p3MayVerifyPublicUrl": true,
    "p3MayBuildAndroidApk": true,
    "p3MayCallPaidServices": false,
    "p3MayReplaceDeploymentPipeline": false,
    "onFailure": "retry-then-report"
  }
}
